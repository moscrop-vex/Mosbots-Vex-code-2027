{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build VEX project",
      "type": "shell",
      "command": "make",
      "args": [
        "T=${env:HOME}/sdk"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Clean VEX project",
      "type": "shell",
      "command": "make clean",
      "args": [
        "T=${env:HOME}/sdk"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
